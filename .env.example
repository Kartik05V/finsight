# Copy this file to .env and fill in your key(s).
#
# GROQ is the default provider — it's genuinely free (generous rate limits,
# no card needed). Get a key at https://console.groq.com/keys

FINSIGHT_PROVIDER=groq
GROQ_API_KEY=

# Only needed if you switch FINSIGHT_PROVIDER=openai instead:
OPENAI_API_KEY=

# Optional overrides — leave blank to use sensible per-provider defaults:
FINSIGHT_MODEL=
FINSIGHT_FAST_MODEL=
FINSIGHT_STRONG_MODEL=

# Minimum seconds between LLM calls (basic rate limiting for the gateway)
FINSIGHT_MIN_CALL_INTERVAL=1.0
