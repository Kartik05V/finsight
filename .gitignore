# =============================================================================
# FinSight — .gitignore
# =============================================================================

# --- Secrets & API keys (NEVER commit these) ---------------------------------
.env
.env.*
!.env.example

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/
ENV/

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
.eggs/

# Pytest / coverage
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.tox/

# Mypy / type checking
.mypy_cache/
.dmypy.json

# Ruff / linting
.ruff_cache/

# --- Jupyter / notebooks -----------------------------------------------------
.ipynb_checkpoints/
*.ipynb

# --- Streamlit ---------------------------------------------------------------
.streamlit/secrets.toml

# --- Data files (keep sample, ignore real uploads) ---------------------------
data/uploads/
data/*.pdf
data/*.xlsx
data/*.xls
# Keep the sample CSV in version control
!data/sample_statement.csv

# --- LangChain / LLM caches --------------------------------------------------
.langchain.db
langchain_cache/

# --- OS files ----------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# --- IDEs & editors ----------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~

# --- Logs --------------------------------------------------------------------
*.log
logs/
